{
  "$comment": "Liste blanche des illustrations (ADR 0029). Copie exacte dans api/app/imports/illustration_regles.json, vérifiée par un test.",
  "taille_max": 100000,
  "elements_max": 2000,
  "elements": [
    "svg",
    "title",
    "desc",
    "g",
    "defs",
    "use",
    "symbol",
    "marker",
    "rect",
    "circle",
    "ellipse",
    "line",
    "polyline",
    "polygon",
    "path",
    "text",
    "tspan",
    "linearGradient",
    "radialGradient",
    "stop"
  ],
  "avec_texte": ["text", "tspan", "title", "desc"],
  "attributs": {
    "id": "id",
    "href": "lien",
    "fill": "couleur",
    "stroke": "couleur",
    "stop-color": "couleur",
    "marker-start": "url",
    "marker-mid": "url",
    "marker-end": "url",
    "d": "chemin",
    "transform": "transformation",
    "gradientTransform": "transformation",
    "viewBox": "nombre",
    "x": "nombre",
    "y": "nombre",
    "x1": "nombre",
    "y1": "nombre",
    "x2": "nombre",
    "y2": "nombre",
    "cx": "nombre",
    "cy": "nombre",
    "r": "nombre",
    "rx": "nombre",
    "ry": "nombre",
    "fx": "nombre",
    "fy": "nombre",
    "fr": "nombre",
    "width": "nombre",
    "height": "nombre",
    "points": "nombre",
    "dx": "nombre",
    "dy": "nombre",
    "offset": "nombre",
    "opacity": "nombre",
    "fill-opacity": "nombre",
    "stroke-opacity": "nombre",
    "stop-opacity": "nombre",
    "stroke-width": "nombre",
    "stroke-dasharray": "nombre",
    "stroke-dashoffset": "nombre",
    "stroke-miterlimit": "nombre",
    "font-size": "nombre",
    "letter-spacing": "nombre",
    "markerWidth": "nombre",
    "markerHeight": "nombre",
    "refX": "nombre",
    "refY": "nombre",
    "pathLength": "nombre",
    "textLength": "nombre",
    "fill-rule": "mot",
    "stroke-linecap": "mot",
    "stroke-linejoin": "mot",
    "font-weight": "mot",
    "font-style": "mot",
    "text-anchor": "mot",
    "dominant-baseline": "mot",
    "gradientUnits": "mot",
    "spreadMethod": "mot",
    "orient": "mot",
    "markerUnits": "mot",
    "preserveAspectRatio": "mot",
    "lengthAdjust": "mot"
  },
  "formats": {
    "nombre": "^[-+0-9.eE%, \\t\\r\\n]+$",
    "chemin": "^[MmLlHhVvCcSsQqTtAaZz0-9eE.,+\\- \\t\\r\\n]+$",
    "transformation": "^[ \\t\\r\\n]*((matrix|translate|scale|rotate|skewX|skewY)[ \\t\\r\\n]*\\([-+0-9.eE, \\t\\r\\n]*\\)[ ,\\t\\r\\n]*)+$",
    "mot": "^[A-Za-z0-9 \\-]+$",
    "id": "^[A-Za-z][A-Za-z0-9_\\-]{0,49}$",
    "lien": "^#[A-Za-z][A-Za-z0-9_\\-]{0,49}$",
    "url": "^url\\(#[A-Za-z][A-Za-z0-9_\\-]{0,49}\\)$"
  },
  "couleurs": {
    "$comment": "Nom dans l'illustration → jeton de tokens.css. Celles du thème changent en sombre, les illu-* jamais.",
    "theme": [
      "texte",
      "texte-doux",
      "primaire",
      "turquoise",
      "succes",
      "erreur",
      "bordure",
      "surface",
      "fond",
      "peche",
      "menthe",
      "soleil",
      "sakura",
      "ciel"
    ],
    "fixes": [
      "illu-blanc",
      "illu-noir",
      "illu-gris",
      "illu-rouge",
      "illu-orange",
      "illu-jaune",
      "illu-vert",
      "illu-bleu",
      "illu-violet",
      "illu-bois-clair",
      "illu-bois-fonce"
    ]
  }
}
