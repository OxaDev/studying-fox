    "api:types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "vba": "vite-node scripts/executer-vba.ts",
    "python": "vite-node scripts/executer-python.ts",
    "verifier": "vite-node scripts/verifier-paquet.ts",
