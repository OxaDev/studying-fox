# Configuration du serveur, lue par Docker Compose et par le Makefile.
# `make configurer` la copie dans infra/.env et génère un mot de passe pour la base.
# Ne jamais versionner le .env.

# Fichiers Compose : Caddy derrière le nginx de la machine (ADR 0031).
# Pour que Caddy gère seul le HTTPS (ports 80 et 443), garder seulement docker-compose.yml.
COMPOSE_FILE=docker-compose.yml:docker-compose.nginx.yml

# Domaine vu par les visiteurs, sans https:// ni chemin.
DOMAINE=domain.com

# Chemin du site sous le domaine : commence par « / », sans barre finale.
# Vide si le site est à la racine du domaine. Le changer demande `make deployer`.
CHEMIN_BASE=/studying-fox

# Port local sur lequel nginx joint Caddy (127.0.0.1 seulement).
PORT_HTTP=8080

# Mot de passe de PostgreSQL. Ne plus le changer une fois la base créée.
POSTGRES_PASSWORD=a-generer

# Confirmation de l'email : à activer avec un service d'envoi (ADR 0023).
RENARD_VERIFICATION_EMAIL=false

RENARD_ENVIRONNEMENT=prod
